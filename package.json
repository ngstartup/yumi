{
  "name": "yumi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Yumi — Learn English. Build your future.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "icons:native": "npm run icons && capacitor-assets generate --iconBackgroundColor '#2F62F0' --iconBackgroundColorDark '#2F62F0' --splashBackgroundColor '#FFFFFF' --splashBackgroundColorDark '#0B1B34'",
    "mobile:init": "npm run build && cap add android && cap sync android",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "mobile:doctor": "cap doctor",
    "bundle": "npm run build && node scripts/make-bundle.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-updater": "^7.51.15",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.2"
  }
}
